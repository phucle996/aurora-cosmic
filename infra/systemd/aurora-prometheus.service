[Unit]
Description=AURORA Prometheus Metrics Server (native)
PartOf=aurora.target

[Service]
Type=simple
ExecStart=%h/.local/bin/prometheus --config.file=%h/Desktop/aurora-cosmic/infra/prometheus/prometheus.yml --storage.tsdb.path=%h/.local/share/aurora/prometheus-data --web.listen-address=0.0.0.0:9090
Restart=on-failure
RestartSec=3
KillSignal=SIGINT

[Install]
WantedBy=aurora.target
