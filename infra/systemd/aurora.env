# AURORA Unified Production Environment
AURORA_ENV=production
AURORA_LOG_LEVEL=info

# Storage (MinIO)
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aurora
AURORA_PREDICTION_BUCKET=aurora

# Message Broker (NATS JetStream)
NATS_URL=nats://127.0.0.1:4222

# Observability (Prometheus)
PROMETHEUS_URL=http://127.0.0.1:9090

# API Gateway & Control
AURORA_API_HOST=0.0.0.0
AURORA_API_PORT=8080
AURORA_CORS_ALLOWED_ORIGIN=http://localhost:8501
INGESTER_CONTROL_URL=http://127.0.0.1:8087

# ClickHouse OLAP
AURORA_CLICKHOUSE_TCP_ADDR=127.0.0.1:9004
AURORA_CLICKHOUSE_HOST=127.0.0.1
AURORA_CLICKHOUSE_PORT=8123
AURORA_CLICKHOUSE_USER=aurora
AURORA_CLICKHOUSE_PASSWORD=aurora-dev-password
AURORA_CLICKHOUSE_DATABASE=aurora

# Ingestion Engine
AURORA_INGEST_CONCURRENCY=8
AURORA_CHECKPOINT_FLUSH_INTERVAL=5s
AURORA_INGEST_CONTROL_ADDR=:8087
AURORA_BRONZE_MAX_BYTES=107374182400
AURORA_BRONZE_HIGH_WATERMARK_BYTES=53687091200
AURORA_BRONZE_LOW_WATERMARK_BYTES=10737418240
MAST_API_URL=https://mast.stsci.edu/api/v0/invoke
MAST_TIMEOUT=90s
MAST_DISCOVERY_TIMEOUT=10m
MAST_PAGE_SIZE=5000

# Preprocessor
AURORA_PREPROCESS_WORKERS=4
AURORA_PREPROCESS_CONTROL_SUBJECT=aurora.v1.preprocessing.control
AURORA_PREPROCESS_AUTOSTART=false
AURORA_PREPROCESS_TMP_DIR=/home/phucle/.cache/aurora-preprocessor
AURORA_TPF_NORMALIZATION=chunk-temporal-median
AURORA_TPF_CHUNK_CADENCES=256
AURORA_LARGE_STAGING_THRESHOLD_BYTES=1073741824
AURORA_LARGE_STAGING_CONCURRENCY=1

# Inference Runtime
AURORA_ML_DEVICE=auto
AURORA_INFERENCE_STREAM=AURORA_INFERENCE
AURORA_INFERENCE_DURABLE=aurora-rust-inference
AURORA_INFERENCE_SUBJECT=aurora.v1.inference.candidate.requested
AURORA_INFERENCE_WORKERS=1
AURORA_INFERENCE_ACK_WAIT_SECS=300
AURORA_INFERENCE_INTRA_THREADS=1
AURORA_INFERENCE_MAX_GOLD_BYTES=536870912

# Python ML Worker & Enrichment
AURORA_ML_MAX_VRAM_MB=2000
AURORA_ENRICHMENT_WORKER_CONCURRENCY=2
AURORA_ENRICHMENT_SCRATCH_DIR=/home/phucle/.local/share/aurora/enrichment-scratch
AURORA_ENRICHMENT_DURABLE=aurora-enrichment
AURORA_ENRICHMENT_STREAM=AURORA_SILVER

# Native Library and Accelerator Paths
PKG_CONFIG_PATH=/home/phucle/.local/lib/pkgconfig
LD_LIBRARY_PATH=/home/phucle/.local/lib
CUDA_VISIBLE_DEVICES=0
