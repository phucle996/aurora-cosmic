[Unit]
Description=AURORA Rust preprocessor (native release)
Requires=aurora-nats.service aurora-minio-init.service
After=aurora-nats.service aurora-minio-init.service
PartOf=aurora.target
ConditionPathExists=%h/.local/lib/pkgconfig/cfitsio.pc

[Service]
Type=simple
WorkingDirectory=%h/.local/share/aurora
EnvironmentFile=%h/.config/aurora/aurora.env
Environment=AURORA_METRICS_ADDR=0.0.0.0:8082
ExecStart=%h/.local/bin/aurora-preprocessor
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
SuccessExitStatus=0 1 2 130 143 SIGINT SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=aurora.target
