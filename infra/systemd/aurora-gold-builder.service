[Unit]
Description=AURORA Gold Builder (native dev)
Requires=aurora-infra.service
After=aurora-infra.service
PartOf=aurora-dev.target

[Service]
Type=simple
WorkingDirectory=%h/Desktop/aurora-cosmic/apps/python-gold-builder
EnvironmentFile=%h/Desktop/aurora-cosmic/apps/python-gold-builder/.env.example
EnvironmentFile=%h/Desktop/aurora-cosmic/infra/systemd/aurora-host.env
Environment=MINIO_ENDPOINT=http://127.0.0.1:9000
Environment=NATS_URL=nats://127.0.0.1:4222
Environment=AURORA_CLICKHOUSE_HOST=127.0.0.1
Environment=PYTHONPATH=%h/Desktop/aurora-cosmic/apps/python-ml-worker
Environment=UV_CACHE_DIR=%h/.cache/uv
ExecStartPre=%h/.local/bin/uv python install 3.12
ExecStartPre=%h/.local/bin/uv sync --project %h/Desktop/aurora-cosmic/apps/python-gold-builder --python 3.12
ExecStart=%h/.local/bin/uv run --project %h/Desktop/aurora-cosmic/apps/python-gold-builder --no-sync python -m aurora.gold_builder.service
Restart=on-failure
RestartSec=5
KillSignal=SIGINT

[Install]
WantedBy=aurora-dev.target
