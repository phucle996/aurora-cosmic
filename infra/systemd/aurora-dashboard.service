[Unit]
Description=AURORA dashboard Vite dev server
After=aurora-go-api.service
PartOf=aurora.target

[Service]
Type=simple
WorkingDirectory=%h/Desktop/aurora-cosmic/apps/dashboard
EnvironmentFile=%h/Desktop/aurora-cosmic/apps/dashboard/.env.example
Environment=VITE_AURORA_API_URL=/api
ExecStart=%h/.local/bin/npm run dev -- --host 0.0.0.0 --port 8501
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
SuccessExitStatus=0 1 2 130 143 SIGINT SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=aurora.target
