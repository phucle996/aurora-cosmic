[Unit]
Description=AURORA Go ingester (native)
Requires=aurora-nats.service aurora-minio-init.service
After=aurora-nats.service aurora-minio-init.service
PartOf=aurora.target

[Service]
Type=simple
WorkingDirectory=%h/Desktop/aurora-cosmic/apps/go-ingester
EnvironmentFile=%h/Desktop/aurora-cosmic/apps/go-ingester/.env.example
EnvironmentFile=%h/Desktop/aurora-cosmic/infra/systemd/aurora-host.env
Environment=MINIO_ENDPOINT=http://127.0.0.1:9000
Environment=NATS_URL=nats://127.0.0.1:4222
ExecStart=%h/.local/go/bin/go run ./cmd
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
SuccessExitStatus=0 1 2 130 143 SIGINT SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=aurora.target
