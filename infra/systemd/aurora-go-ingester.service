[Unit]
Description=AURORA Go ingester (native)
Requires=aurora-nats.service aurora-minio-init.service
After=aurora-nats.service aurora-minio-init.service
PartOf=aurora.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/aurora
EnvironmentFile=%h/.config/aurora/aurora.env
Environment=AURORA_METRICS_ADDR=:8081
ExecStart=%h/.local/bin/aurora-ingester
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
SuccessExitStatus=0 1 2 130 143 SIGINT SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=aurora.target
