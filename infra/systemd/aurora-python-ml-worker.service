[Unit]
Description=AURORA Python ML worker (native production)
Requires=aurora-nats.service aurora-minio-init.service aurora-clickhouse-init.service
After=aurora-nats.service aurora-minio-init.service aurora-clickhouse-init.service
PartOf=aurora.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/aurora/apps/python-ml-worker
EnvironmentFile=%h/.config/aurora/aurora.env
Environment=AURORA_METRICS_ADDR=0.0.0.0:8083
ExecStart=%h/.local/share/aurora/apps/python-ml-worker/.venv/bin/python service.py
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
SuccessExitStatus=0 1 2 130 143 SIGINT SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=aurora.target
