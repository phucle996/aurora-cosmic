[Unit]
Description=AURORA Enrichment Service (native production)
Requires=aurora-nats.service aurora-minio-init.service aurora-clickhouse-init.service
After=aurora-nats.service aurora-minio-init.service aurora-clickhouse-init.service
PartOf=aurora.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/aurora/apps/python-enrichment
EnvironmentFile=%h/.config/aurora/aurora.env
Environment=PYTHONPATH=%h/.local/share/aurora/apps/python-enrichment:%h/.local/share/aurora/apps/python-ml-worker
ExecStart=%h/.local/share/aurora/apps/python-enrichment/.venv/bin/python service.py
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
SuccessExitStatus=0 1 2 130 143 SIGINT SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=aurora.target
