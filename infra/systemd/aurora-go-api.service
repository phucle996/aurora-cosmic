[Unit]
Description=AURORA Go API (native)
Requires=aurora-nats.service aurora-minio-init.service aurora-clickhouse-init.service
After=aurora-nats.service aurora-minio-init.service aurora-clickhouse-init.service aurora-go-ingester.service
PartOf=aurora.target

[Service]
Type=simple
WorkingDirectory=%h/Desktop/aurora-cosmic/apps/go-api
EnvironmentFile=%h/Desktop/aurora-cosmic/apps/go-api/.env.example
EnvironmentFile=%h/Desktop/aurora-cosmic/infra/systemd/aurora-host.env
Environment=MINIO_ENDPOINT=http://127.0.0.1:9000
Environment=NATS_URL=nats://127.0.0.1:4222
Environment=PROMETHEUS_URL=http://127.0.0.1:9090
Environment=INGESTER_CONTROL_URL=http://127.0.0.1:8087
Environment=AURORA_CLICKHOUSE_ENDPOINT=http://127.0.0.1:8123
ExecStart=%h/.local/go/bin/go run ./cmd/aurora-api
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
SuccessExitStatus=0 1 2 130 143 SIGINT SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=aurora.target
