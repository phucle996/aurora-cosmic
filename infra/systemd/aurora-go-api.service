[Unit]
Description=AURORA Go API (native)
Requires=aurora-nats.service aurora-minio-init.service aurora-clickhouse-init.service
After=aurora-nats.service aurora-minio-init.service aurora-clickhouse-init.service aurora-go-ingester.service
PartOf=aurora.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/aurora
EnvironmentFile=%h/.config/aurora/aurora.env
ExecStart=%h/.local/bin/aurora-api
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
SuccessExitStatus=0 1 2 130 143 SIGINT SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=aurora.target
