# Host-facing endpoints for native app services. Docker Compose publishes
# these infrastructure ports on loopback, while Docker DNS names such as
# `nats` and `minio` only resolve inside the Compose network.
MINIO_ENDPOINT=http://127.0.0.1:9000
NATS_URL=nats://127.0.0.1:4222
PROMETHEUS_URL=http://127.0.0.1:9090
INGESTER_CONTROL_URL=http://127.0.0.1:8087
AURORA_CLICKHOUSE_ENDPOINT=http://127.0.0.1:8123
AURORA_CLICKHOUSE_HOST=127.0.0.1
AURORA_CLICKHOUSE_PORT=8123
AURORA_CLICKHOUSE_USER=aurora
AURORA_CLICKHOUSE_PASSWORD=aurora-dev-password
AURORA_CLICKHOUSE_DATABASE=aurora
AURORA_ML_MAX_VRAM_MB=2000
