[Unit]
Description=AURORA systemd user-service Prometheus exporter
PartOf=aurora.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/aurora
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 %h/.local/bin/aurora-systemd-exporter
Restart=on-failure
RestartSec=3
KillSignal=SIGINT

[Install]
WantedBy=aurora.target
