<clickhouse>
    <logger>
        <level>information</level>
        <log>/home/phucle/.local/share/aurora/clickhouse-log/clickhouse-server.log</log>
        <errorlog>/home/phucle/.local/share/aurora/clickhouse-log/clickhouse-server.err.log</errorlog>
        <size>10M</size>
        <count>3</count>
    </logger>
    <http_port>8123</http_port>
    <tcp_port>9004</tcp_port>
    <listen_host>127.0.0.1</listen_host>
    <path>/home/phucle/.local/share/aurora/clickhouse-data/</path>
    <tmp_path>/home/phucle/.local/share/aurora/clickhouse-data/tmp/</tmp_path>
    <user_files_path>/home/phucle/.local/share/aurora/clickhouse-data/user_files/</user_files_path>
    <users_config>/home/phucle/.config/aurora/clickhouse/users.xml</users_config>
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>
</clickhouse>
