<clickhouse>
    <!-- Expose ClickHouse's native Prometheus endpoint on the internal
         monitoring port. Prometheus scrapes this over aurora-net. -->
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>
</clickhouse>
