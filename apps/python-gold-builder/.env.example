AURORA_ENV=development
AURORA_LOG_LEVEL=INFO
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aurora
NATS_URL=nats://nats:4222
# Flush after 30 seconds without a new Silver event. The size cap protects the
# builder from an unbounded batch during sustained ingestion.
AURORA_GOLD_MAX_BATCH_SIZE=5000
AURORA_GOLD_FLUSH_SECONDS=30
AURORA_GOLD_WORKER_CONCURRENCY=2
AURORA_GOLD_DURABLE=aurora-gold-builder
AURORA_GOLD_STREAM=AURORA_SILVER
AURORA_GOLD_SET_CURRENT=false
