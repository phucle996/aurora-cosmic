AURORA_ENV=development
AURORA_LOG_LEVEL=INFO
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aurora
NATS_URL=nats://nats:4222
AURORA_GOLD_BATCH_SIZE=100
AURORA_GOLD_FLUSH_SECONDS=300
AURORA_GOLD_DURABLE=aurora-gold-builder
AURORA_GOLD_STREAM=AURORA_SILVER
AURORA_GOLD_SET_CURRENT=false
