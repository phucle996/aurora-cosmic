AURORA_ENV=development
AURORA_LOG_LEVEL=info

MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=aurora
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

NATS_URL=nats://nats:4222

# This worker accepts explicit CPU and GPU requests. CUDA is required only for GPU jobs.
AURORA_ML_DEVICE=auto
AURORA_ML_BATCH_SIZE=32
AURORA_ML_MAX_VRAM_MB=3500
AURORA_ML_WORK_DIR=.runtime/ml-worker
CUDA_VISIBLE_DEVICES=0
AURORA_METRICS_ADDR=0.0.0.0:8083

AURORA_CLICKHOUSE_HOST=clickhouse
AURORA_CLICKHOUSE_PORT=8123
AURORA_CLICKHOUSE_USER=aurora
AURORA_CLICKHOUSE_PASSWORD=aurora-dev-password
AURORA_CLICKHOUSE_DATABASE=aurora
