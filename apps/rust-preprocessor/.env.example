AURORA_ENV=development
AURORA_LOG_LEVEL=info

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aurora

NATS_URL=nats://nats:4222
AURORA_PREPROCESS_CONTROL_SUBJECT=aurora.v1.preprocessing.control
# Starts only after the dashboard/API sends a preprocessing command.
AURORA_PREPROCESS_AUTOSTART=false

# Prometheus observer endpoint
AURORA_METRICS_ADDR=0.0.0.0:8082

AURORA_PREPROCESS_WORKERS=4
# Optional — defaults shown:
# AURORA_PREPROCESS_DURABLE=aurora-rust-preprocessor
# AURORA_PREPROCESS_STREAM=AURORA_BRONZE
# AURORA_PREPROCESS_ACK_WAIT=30s
# AURORA_PREPROCESS_SHUTDOWN_TIMEOUT=30
# Defaults to ~/.cache/aurora-preprocessor; never rely on a small /tmp tmpfs
# for multi-GB FITS staging.
# AURORA_PREPROCESS_TMP_DIR=~/.cache/aurora-preprocessor
# Large TPF staging is admitted separately so concurrent downloads cannot
# exhaust the staging filesystem. Defaults: 1 GiB threshold, one large file.
AURORA_LARGE_STAGING_THRESHOLD_BYTES=1073741824
AURORA_LARGE_STAGING_CONCURRENCY=1

# Light Curve Preprocessing parameters:
# AURORA_LC_MIN_POINTS=100
# AURORA_LC_QUALITY_MODE=strict
# AURORA_LC_ALLOW_SAP_FALLBACK=false
# AURORA_LC_SIGMA_CLIP=

# TPF preprocessing parameters:
# AURORA_TPF_QUALITY_MODE=strict
# `chunk-temporal-median` keeps multi-GB Target Pixel Files memory-bounded.
# It uses a temporal median within each cadence chunk and writes one Parquet
# row group per chunk. `temporal-median` requires materializing the full cube.
AURORA_TPF_NORMALIZATION=chunk-temporal-median
# Maximum TPF cadences kept in memory per read / Parquet row group.
AURORA_TPF_CHUNK_CADENCES=256
