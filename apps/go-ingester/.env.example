AURORA_ENV=development
AURORA_LOG_LEVEL=info

MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=aurora
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

NATS_URL=nats://nats:4222

# Prometheus observer endpoint
AURORA_METRICS_ADDR=:8081
AURORA_INGEST_CONTROL_ADDR=:8087

# Ingestion is control-plane driven. The service starts idle and only a
# POST from the dashboard control route can create an ingest job.
# Start at 8; ramp to 16 only after checking MAST 429 rate and MinIO latency.
AURORA_INGEST_CONCURRENCY=8
# Checkpoint progress is flushed in batches instead of once per product.
AURORA_CHECKPOINT_FLUSH_INTERVAL=5s

AURORA_BRONZE_MAX_BYTES=107374182400
AURORA_BRONZE_HIGH_WATERMARK_BYTES=53687091200
AURORA_BRONZE_LOW_WATERMARK_BYTES=10737418240

# MAST API
MAST_API_URL=https://mast.stsci.edu/api/v0/invoke
MAST_TIMEOUT=90s
MAST_PAGE_SIZE=1000

# Manifest selection is deliberately not configurable: every accepted target
# always contains one matched TPF + light-curve pair.
