AURORA_ENV=development
AURORA_LOG_LEVEL=info

MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=aurora

NATS_URL=nats://nats:4222

AURORA_INGEST_MODE=stream
# Start at 8; ramp to 16 only after checking MAST 429 rate and MinIO latency.
AURORA_INGEST_CONCURRENCY=8
# Checkpoint progress is flushed in batches instead of once per product.
AURORA_CHECKPOINT_FLUSH_INTERVAL=5s

AURORA_BRONZE_MAX_BYTES=53687091200
AURORA_BRONZE_HIGH_WATERMARK_BYTES=48318382080
AURORA_BRONZE_LOW_WATERMARK_BYTES=32212254720

# MAST API
MAST_API_URL=https://mast.stsci.edu/api/v0/invoke
MAST_TIMEOUT=30s
MAST_PAGE_SIZE=1000

# Manifest selection policy
AURORA_INCLUDE_TPF=true
AURORA_INCLUDE_LIGHTCURVE=true
AURORA_INCLUDE_FFI=true
AURORA_REQUIRE_TPF_LC_PAIR=true
