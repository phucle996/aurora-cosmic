AURORA_ENV=development
AURORA_LOG_LEVEL=info

AURORA_API_HOST=0.0.0.0
AURORA_API_PORT=8080
AURORA_API_METRICS_ADDR=:8086

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aurora
AURORA_PREDICTION_BUCKET=aurora

NATS_URL=nats://nats:4222
PROMETHEUS_URL=http://prometheus:9090
INGESTER_CONTROL_URL=http://go-ingester:8087

AURORA_CLICKHOUSE_ENDPOINT=http://clickhouse:8123
AURORA_CLICKHOUSE_DATABASE=aurora
AURORA_CLICKHOUSE_USER=aurora
AURORA_CLICKHOUSE_PASSWORD=aurora-dev-password

# Set this to the public dashboard origin in deployed environments.
AURORA_CORS_ALLOWED_ORIGIN=http://localhost:8501
