AURORA_ENV=development
AURORA_LOG_LEVEL=INFO
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aurora
NATS_URL=nats://nats:4222
AURORA_CLICKHOUSE_HOST=clickhouse
AURORA_CLICKHOUSE_PORT=8123
AURORA_CLICKHOUSE_USER=aurora
AURORA_CLICKHOUSE_PASSWORD=aurora-dev-password
AURORA_CLICKHOUSE_DATABASE=aurora
# Batch size and stream flush duration belong to the durable dashboard control
# record, not process environment. This service only owns worker concurrency.
AURORA_ENRICHMENT_WORKER_CONCURRENCY=2
# Disk-backed temporary workspace for exact TPF statistics. Keep this on a
# real filesystem, not a tmpfs, because large TPFs are deliberately not held in RAM.
AURORA_ENRICHMENT_SCRATCH_DIR=.runtime/enrichment-scratch
AURORA_ENRICHMENT_DURABLE=aurora-enrichment
AURORA_ENRICHMENT_STREAM=AURORA_SILVER
AURORA_ENRICHMENT_METRICS_ADDR=:8088
# The service synchronizes TIC and TOI evidence on demand per ready Gold batch,
# pins immutable snapshots in MinIO, and never creates a partial Gold artifact.
