{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InferenceJobRequestedEvent",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "occurred_at",
    "task",
    "job_id",
    "job_manifest_bucket",
    "job_manifest_key",
    "job_manifest_sha256",
    "runtime_package_id",
    "gold_snapshot_id",
    "gold_artifact_key",
    "sector",
    "expected_prediction_count",
    "producer"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "event_id": { "type": "string" },
    "event_type": { "type": "string", "enum": ["aurora.v1.inference.candidate.requested", "aurora.v1.inference.anomaly.requested"] },
    "occurred_at": { "type": "string", "format": "date-time" },
    "task": { "type": "string", "enum": ["candidate_vetting", "astronomical_anomaly_detection"] },
    "job_id": { "type": "string", "pattern": "^inference-job-v1-[0-9a-f]{16,64}$" },
    "job_manifest_bucket": { "type": "string", "default": "aurora-manifests" },
    "job_manifest_key": { "type": "string" },
    "job_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "runtime_package_id": { "type": "string" },
    "gold_snapshot_id": { "type": "string" },
    "gold_artifact_key": { "type": "string" },
    "sector": { "type": "integer", "minimum": 1 },
    "expected_prediction_count": { "type": "integer", "minimum": 1 },
    "producer": { "type": "string", "default": "python-ml-worker" }
  },
  "additionalProperties": false
}
