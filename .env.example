# ===============================================================================
# AURORA Cosmic Data Platform - Environment Configuration Example
# Copy to .env for local development
# ===============================================================================

AURORA_ENV=development

# MinIO Object Storage Configuration
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aurora
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_BUCKET_BRONZE=aurora-bronze
MINIO_BUCKET_SILVER=aurora-silver
MINIO_BUCKET_GOLD=aurora-gold
MINIO_BUCKET_MODELS=aurora-models

# NATS JetStream Event Plane Configuration
NATS_URL=nats://nats:4222
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222

# ClickHouse Analytical Storage
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000

# Storage Lifecycle & Watermarks (~50 GiB Budget)
AURORA_BRONZE_MAX_BYTES=53687091200
AURORA_BRONZE_HIGH_WATERMARK=0.85
AURORA_BRONZE_LOW_WATERMARK=0.60

# GPU Acceleration Settings
CUDA_VISIBLE_DEVICES=0
